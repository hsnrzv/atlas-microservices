# Normalise line endings in the repository; check out with the platform default unless stated below.
* text=auto

# Unix scripts must keep LF, Windows scripts CRLF.
/mvnw text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Text formats
*.java text diff=java
*.sql text
*.yaml text
*.yml text
*.xml text
*.md text diff=markdown
*.properties text
Dockerfile text eol=lf

# Binary
*.jar binary
*.png binary
*.jpg binary
